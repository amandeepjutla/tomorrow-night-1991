###############################################################
# Tomorrow Night 1991 -- a skin for a terminal with a dark background
#
# Author: Claude Opus 5
# Created: 2026-09-21, at the request of Amandeep Jutla.
# https://github.com/amandeepjutla/tomorrow-night-1991
#
# Derived from broot's dark-gruvbox skin: every key and its role is kept,
# with each gruvbox color replaced by its Tomorrow Night 1991 counterpart.
#
# Doc at https://dystroy.org/broot/skins/
###############################################################
skin: {
    default: rgb(204,204,204) none / rgb(180,183,180) none
    tree: rgb(55,59,65) None / rgb(40,42,46) None
    parent: rgb(204,204,204) none / rgb(180,183,180) none Italic
    file: None None / None  None Italic
    directory: rgb(102,204,204) None Bold / rgb(102,204,204) None
    exe: rgb(202,225,197) None
    link: rgb(141,210,212) None
    pruning: rgb(153,153,153) None Italic
    perm__: None None
    perm_r: rgb(255,204,102) None
    perm_w: rgb(242,119,122) None
    perm_x: rgb(153,204,153) None
    owner: rgb(255,204,102) None Bold
    group: rgb(255,204,102) None
    count: rgb(102,153,204) rgb(40,42,46)
    dates: rgb(153,153,153) None
    sparse: rgb(250,225,164) None
    content_extract: rgb(102,204,204) None Italic
    content_match: rgb(153,204,153) None Bold
    git_branch: rgb(255,255,255) None
    git_insertions: rgb(153,204,153) None
    git_deletions: rgb(232,146,143) None
    git_status_current: rgb(40,42,46) None
    git_status_modified: rgb(153,204,153) None
    git_status_new: rgb(153,204,153) None Bold
    git_status_ignored: rgb(224,224,224) None
    git_status_conflicted: rgb(242,119,122) None
    git_status_other: rgb(242,119,122) None
    selected_line: None rgb(55,59,65) / None rgb(40,42,46)
    char_match: rgb(250,225,164) None
    file_error: rgb(242,178,174) None
    flag_label: rgb(180,183,180) None
    flag_value: rgb(223,199,224) None Bold
    input: rgb(255,255,255) None / rgb(180,183,180) None Italic
    status_error: rgb(224,224,224) rgb(242,119,122)
    status_job: rgb(250,225,164) rgb(40,42,46)
    status_normal: None rgb(29,31,33) / None None
    status_italic: rgb(223,199,224) rgb(29,31,33) Italic / None None
    status_bold: rgb(223,199,224) rgb(29,31,33) Bold / None None
    status_code: rgb(255,255,255) rgb(29,31,33) / None None
    status_ellipsis: rgb(255,255,255) rgb(29,31,33)  Bold / None None
    purpose_normal: None None
    purpose_italic: rgb(204,153,204) None Italic
    purpose_bold: rgb(204,153,204) None Bold
    purpose_ellipsis: None None
    scrollbar_track: rgb(55,59,65) None / rgb(40,42,46) None
    scrollbar_thumb: rgb(224,224,224) None / rgb(55,59,65) None
    help_paragraph: None None
    help_bold: rgb(249,145,87) None Bold
    help_italic: rgb(223,199,224) None Italic
    help_code: rgb(177,210,173) rgb(40,42,46)
    help_headers: rgb(249,145,87) None Bold
    help_table_border: rgb(55,59,65) None
    preview_title: rgb(204,204,204) rgb(29,31,33) / rgb(180,183,180) rgb(29,31,33)
    preview: rgb(204,204,204) rgb(29,31,33) / rgb(204,204,204) rgb(29,31,33)
    preview_line_number: rgb(153,153,153) None / rgb(153,153,153) rgb(29,31,33)
    preview_separator: rgb(55,59,65) None / rgb(40,42,46) None
    preview_match: None rgb(102,204,204) Bold
    hex_null: rgb(180,183,180) None
    hex_ascii_graphic: rgb(224,224,224) None
    hex_ascii_whitespace: rgb(153,204,153) None
    hex_ascii_other: rgb(249,145,87) None
    hex_non_ascii: rgb(249,145,87) None
    staging_area_title: rgb(204,204,204) rgb(29,31,33) / rgb(180,183,180) rgb(29,31,33)
    mode_command_mark: gray(5) rgb(204,153,204) Bold
    good_to_bad_0: rgb(153,204,153)
    good_to_bad_1: rgb(102,204,204)
    good_to_bad_2: rgb(102,204,204)
    good_to_bad_3: rgb(102,204,204)
    good_to_bad_4: rgb(102,204,204)
    good_to_bad_5: rgb(255,204,102)
    good_to_bad_6: rgb(255,204,102)
    good_to_bad_7: rgb(249,145,87)
    good_to_bad_8: rgb(249,145,87)
    good_to_bad_9: rgb(242,119,122)
}
